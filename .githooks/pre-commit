#!/usr/bin/env bash
# Keep .scratch/<feature>/ticket-dependency.html in sync with issues/*.md.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

changed="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.scratch/[^/]+/issues/.*\.md$' || true)"
[ -z "$changed" ] && exit 0

dirs="$(printf '%s\n' "$changed" | sed -E 's#^(\.scratch/[^/]+)/issues/.*#\1#' | sort -u)"
while IFS= read -r dir; do
	[ -n "$dir" ] || continue
	[ -f "$dir/ticket-dependency.html" ] || continue
	if ! GOFLAGS= go run ./tools/ticketgraph render --dir "$dir" --check; then
		echo "pre-commit: $dir/ticket-dependency.html is stale; run 'make tickets TICKET_DIR=$dir' and stage it." >&2
		exit 1
	fi
done <<< "$dirs"
